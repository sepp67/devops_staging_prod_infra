# ─────────────────────────────────────────────────────────────────────────────
# Caddyfile — Généré par Ansible
# Environnement : {{ environment_name }}
# Ne pas éditer manuellement.
# ─────────────────────────────────────────────────────────────────────────────

{
{% if caddy_tls_mode == "acme" %}
    email {{ caddy_email }}
{% endif %}
}

# ─────────────────────────────────────────────────────────────────────────────
# Projets applicatifs (générés depuis vars/projects/)
#
# Regroupés par (domain, listen_port) : un bloc Caddy par paire.
# listen_port absent → bloc standard (:443/:80).
# listen_port défini → bloc explicite domain:port (ex : :8448 pour la
# fédération Matrix).
# ─────────────────────────────────────────────────────────────────────────────

{% set ns = namespace(blocks_seen=[]) %}
{% for project in projects %}
{%   set _port = project.listen_port | default('') | string %}
{%   set _block_key = project.domain ~ '|' ~ _port %}
{%   if _block_key not in ns.blocks_seen %}
{%     set _ = ns.blocks_seen.append(_block_key) %}

{% if _port %}
{{ project.domain }}:{{ _port }} {
{% else %}
{{ project.domain }} {
{% endif %}
{% if caddy_tls_mode == "internal" %}
    tls internal
{% endif %}

{% for redirect in project.redirects | default([]) %}
    redir {{ redirect.from }} {{ redirect.to }} {{ redirect.status | default(301) }}
{% endfor %}

{% for p in projects if p.domain == project.domain and (p.listen_port | default('') | string) == _port %}
{% if p.route_path is defined and p.route_path != "/" %}
    # Route : {{ p.route_path }} → {{ p.project_name }}
    handle {{ p.route_path }} {
{% if p.strip_prefix is defined and p.strip_prefix %}
        uri strip_prefix {{ p.route_path | regex_replace('/\*$', '') }}
{% endif %}
        reverse_proxy {{ p.backend_host | default(backend_host) }}:{{ p.host_port }}
    }
{% for route in p.extra_routes | default([]) %}
    # Route : {{ route.route_path }} → {{ p.project_name }}
    handle {{ route.route_path }} {
{% if route.strip_prefix is defined and route.strip_prefix %}
        uri strip_prefix {{ route.route_path | regex_replace('/\*$', '') }}
{% endif %}
        reverse_proxy {{ p.backend_host | default(backend_host) }}:{{ p.host_port }}
    }
{% endfor %}
{% else %}
    # Route : / → {{ p.project_name }}
    handle /* {
        reverse_proxy {{ p.backend_host | default(backend_host) }}:{{ p.host_port }}
    }
{% endif %}
{% endfor %}
}
{%   endif %}
{% endfor %}
