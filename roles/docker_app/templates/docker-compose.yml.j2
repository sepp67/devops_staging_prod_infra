---
# Généré par Ansible — ne pas éditer manuellement
# Projet : {{ project.project_name }} | Env : {{ environment_name }}

services:
  {{ project.project_name }}:
    image: "{{ project.image }}"
    restart: unless-stopped
    ports:
      - "{{ docker_bind_address }}:{{ project.host_port }}:{{ project.container_port }}"
{% if project.environment %}
    environment:
{% for key, value in project.environment.items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if project.volumes %}
    volumes:
{% for vol in project.volumes %}
      - "{{ vol }}"
{% endfor %}
{% endif %}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:{{ project.container_port }}/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
